---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Malitha Sandaruwan">
  <main class="max-w-2xl mx-auto px-6 pt-20 sm:pt-28 pb-24 sm:pb-32 font-sans selection:bg-zinc-900 selection:text-zinc-100 dark:selection:bg-zinc-100 dark:selection:text-zinc-900">
    
    <!-- Top Bar: Identity + Theme Switcher -->
    <header class="flex justify-between items-center mb-16 sm:mb-20">
      <a 
        href="/" 
        class="text-sm font-medium text-zinc-900 dark:text-zinc-100 hover:text-zinc-600 dark:hover:text-zinc-300 transition"
      >
        Malitha Sandaruwan
      </a>

      <button 
        id="theme-toggle" 
        type="button" 
        aria-label="Toggle theme"
        class="group p-2 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 hover:border-zinc-400 dark:hover:border-zinc-700 transition cursor-pointer"
      >
        <!-- Sun (Dark Mode Active) -->
        <svg class="w-4 h-4 text-zinc-400 group-hover:text-zinc-100 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <!-- Moon (Light Mode Active) -->
        <svg class="w-4 h-4 text-zinc-600 group-hover:text-zinc-950 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </header>

    <div class="space-y-10 sm:space-y-12">
      
      <!-- Value Proposition & Arsenal -->
      <section class="space-y-3">
        <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed max-w-lg">
          Building reliable backend systems and software tools.
        </p>

        <!-- Technical Arsenal Micro-line -->
        <div class="pt-0.5 flex flex-wrap items-center gap-x-2 text-xs font-mono text-zinc-400 dark:text-zinc-500">
          <span>Linux</span>
          <span class="text-zinc-300 dark:text-zinc-700">·</span>
          <span>Python</span>
          <span class="text-zinc-300 dark:text-zinc-700">·</span>
          <span>Supabase</span>
          <span class="text-zinc-300 dark:text-zinc-700">·</span>
          <span>Docker</span>
          <span class="text-zinc-300 dark:text-zinc-700">·</span>
          <span>Git</span>
        </div>
      </section>

      <!-- Proof of Work -->
      <section class="space-y-3">
        <div class="flex justify-between items-baseline">
          <h2 class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
            Featured System
          </h2>
          <span class="text-xs font-mono text-zinc-400 dark:text-zinc-600">01 / 01</span>
        </div>
        
        <div class="group relative rounded-2xl border border-zinc-200 dark:border-zinc-800/90 bg-zinc-50/60 dark:bg-zinc-900/30 p-6 sm:p-7 hover:border-zinc-400 dark:hover:border-zinc-700 transition-all duration-200">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <h3 class="text-base font-medium text-zinc-900 dark:text-zinc-100">
              Wealth Terminal
            </h3>
            <span class="inline-flex items-center text-xs font-mono text-zinc-500 dark:text-zinc-400">
              Python · Streamlit · Supabase
            </span>
          </div>
          
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-5 max-w-lg">
            Self-hosted financial telemetry and asset tracking dashboard. Aggregates multi-asset portfolio metrics, automates position valuation, and delivers real-time market risk analytics.
          </p>

          <div class="flex items-center gap-4 text-xs font-mono">
            <a 
              href="https://github.com/MalithaSandaru/wealth-terminal" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-zinc-900 text-zinc-100 dark:bg-zinc-100 dark:text-zinc-900 font-medium hover:opacity-90 transition"
            >
              Source Code ↗
            </a>
          </div>
        </div>
      </section>

      <!-- Connect & Direct Contact -->
      <section class="space-y-3 pt-6 sm:pt-8">
        <h2 class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          Connect
        </h2>
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Outbound Social Links -->
          <div class="flex flex-wrap items-center gap-5 text-xs font-mono text-zinc-600 dark:text-zinc-400">
            <a href="https://github.com/MalithaSandaru" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-white transition">GitHub ↗</a>
            <a href="https://x.com/MalithaSandaru" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-white transition">X ↗</a>
            <a href="https://linkedin.com/in/MalithaSandaru" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-white transition">LinkedIn ↗</a>
          </div>

          <!-- In-Place Copy Action -->
          <button 
            id="copy-email" 
            type="button" 
            title="Click to copy email address"
            class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-900/40 text-xs font-mono text-zinc-600 dark:text-zinc-400 hover:border-zinc-400 dark:hover:border-zinc-700 hover:text-zinc-900 dark:hover:text-white transition cursor-pointer self-start sm:self-auto"
          >
            <span id="email-text">contact@malitha.dev</span>
            
            <svg id="copy-icon" class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-600 dark:group-hover:text-zinc-200 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>

            <svg id="check-icon" class="w-3.5 h-3.5 text-emerald-500 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);

  window.addEventListener('keydown', (e) => {
    if (
      e.key.toLowerCase() === 't' && 
      !e.metaKey && 
      !e.ctrlKey && 
      !e.altKey && 
      !['input', 'textarea'].includes((e.target as HTMLElement)?.tagName?.toLowerCase())
    ) {
      toggleTheme();
    }
  });

  const copyBtn = document.getElementById('copy-email');
  const emailText = document.getElementById('email-text');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const targetEmail = 'contact@malitha.dev';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(targetEmail);
      
      if (emailText && copyIcon && checkIcon) {
        emailText.textContent = 'Copied to clipboard';
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');

        setTimeout(() => {
          emailText.textContent = targetEmail;
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      }
    } catch {
      window.location.href = `mailto:${targetEmail}`;
    }
  });
</script>