---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Malitha Sandaruwan" 
  description="Building reliable backend systems, software tools, and financial telemetry dashboards."
>
  <main class="max-w-2xl mx-auto px-6 pt-8 sm:pt-12 pb-20 sm:pb-24 font-sans">
    
    <!-- Top Bar: Identity on Left, Shelf on Right -->
    <header class="flex items-center justify-between mb-8 sm:mb-10">
      <a 
        href="/" 
        class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 hover:text-zinc-700 dark:hover:text-zinc-300 transition duration-150"
      >
        Malitha Sandaruwan
      </a>

      <a 
        href="/shelf" 
        class="text-xs font-mono text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 transition px-3 py-1.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/40 hover:border-zinc-400 dark:hover:border-zinc-700"
      >
        Shelf ↗
      </a>
    </header>

    <div class="space-y-10 sm:space-y-12">
      
      <!-- Value Proposition -->
      <section>
        <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed max-w-lg">
          Building reliable backend systems and software tools.
        </p>
      </section>

      <!-- Proof of Work (Floating Glass Card) -->
      <section class="space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          Featured System
        </h2>
        
        <div class="group relative rounded-3xl border border-zinc-200/80 dark:border-white/10 bg-white/70 dark:bg-zinc-900/60 backdrop-blur-xl p-6 sm:p-7 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.07)] dark:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.6)] hover:-translate-y-1 hover:shadow-[0_20px_40px_-12px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_25px_50px_-15px_rgba(0,0,0,0.8)] hover:border-zinc-300 dark:hover:border-white/20 transition-all duration-300 ease-out">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 mb-3">
            <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-950 dark:group-hover:text-white transition">
              Wealth Terminal
            </h3>
            <span class="w-fit self-start sm:self-auto inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-zinc-200/50 dark:border-zinc-700/50">
              Python · Streamlit · Supabase
            </span>
          </div>
          
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6 max-w-lg">
            Self-hosted financial telemetry and asset tracking dashboard. Aggregates multi-asset portfolio metrics, automates position valuation, and delivers real-time market risk analytics.
          </p>

          <div class="flex items-center gap-4 text-xs font-mono">
            <a 
              href="https://github.com/MalithaSandaru/wealth-terminal" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-zinc-900 text-zinc-100 dark:bg-zinc-100 dark:text-zinc-900 font-medium shadow-sm hover:scale-[1.02] active:scale-[0.98] transition-all duration-150"
            >
              Source Code ↗
            </a>
          </div>
        </div>
      </section>

      <!-- Outbound Links & Direct Contact -->
      <section class="pt-2 sm:pt-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-5 text-xs font-mono text-zinc-600 dark:text-zinc-400">
            <a href="https://github.com/MalithaSandaru" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-white transition">GitHub ↗</a>
            <a href="https://x.com/MalithaSandaru" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-white transition">X ↗</a>
            <a href="https://linkedin.com/in/MalithaSandaru" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-900 dark:hover:text-white transition">LinkedIn ↗</a>
          </div>

          <button 
            id="copy-email" 
            type="button" 
            aria-label="Copy email address"
            title="Click to copy email address"
            class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/60 dark:bg-zinc-900/40 backdrop-blur-md text-xs font-mono text-zinc-600 dark:text-zinc-400 hover:border-zinc-400 dark:hover:border-zinc-700 hover:text-zinc-900 dark:hover:text-white transition cursor-pointer self-start sm:self-auto"
          >
            <span id="email-text">contact@malitha.dev</span>
            <svg id="copy-icon" class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-600 dark:group-hover:text-zinc-200 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg id="check-icon" class="w-3.5 h-3.5 text-emerald-500 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-email');
  const emailText = document.getElementById('email-text');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const targetEmail = 'contact@malitha.dev';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(targetEmail);
      if (emailText && copyIcon && checkIcon) {
        emailText.textContent = 'Copied to clipboard';
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        setTimeout(() => {
          emailText.textContent = targetEmail;
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
        }, 2000);
      }
    } catch {
      window.location.href = `mailto:${targetEmail}`;
    }
  });
</script>