---
import Layout from '../layouts/Layout.astro';

const books = [
  { title: "Hatching Twitter", url: "https://www.amazon.com/dp/1591847087" },
  { title: "Sapiens", url: "https://www.amazon.com/dp/0062316095" },
  { title: "Steve Jobs", url: "https://www.amazon.com/dp/1451648537" },
  { title: "The Black Swan", url: "https://www.amazon.com/dp/081297381X" },
  { title: "American Kingpin", url: "https://www.amazon.com/dp/B06Y1QXMXX" }
];

const cinema = [
  { title: "2001: A Space Odyssey", url: "https://en.wikipedia.org/wiki/2001:_A_Space_Odyssey_(film)" },
  { title: "Black Swan", url: "https://en.wikipedia.org/wiki/Black_Swan_(film)" },
  { title: "Fight Club", url: "https://en.wikipedia.org/wiki/Fight_Club" },
  { title: "Interstellar", url: "https://en.wikipedia.org/wiki/Interstellar_(film)" },
  { title: "Nightcrawler", url: "https://en.wikipedia.org/wiki/Nightcrawler_(film)" },
];

const television = [
  { title: "Succession", url: "https://en.wikipedia.org/wiki/Succession_(TV_series)", ongoing: false },
  { title: "Better Call Saul", url: "https://en.wikipedia.org/wiki/Better_Call_Saul", ongoing: false },
  { title: "Mindhunter", url: "https://en.wikipedia.org/wiki/Mindhunter_(TV_series)", ongoing: false },
  { title: "Mr. Robot", url: "https://en.wikipedia.org/wiki/Mr._Robot", ongoing: false },
  { title: "Pluribus", url: "https://en.wikipedia.org/wiki/Pluribus_(TV_series)", ongoing: true }
];

const documentaries = [
  { title: "AlphaGo", url: "https://en.wikipedia.org/wiki/AlphaGo_(film)" },
  { title: "Jeen-Yuhs", url: "https://en.wikipedia.org/wiki/Jeen-Yuhs" },
  { title: "The Thinking Game", url: "https://en.wikipedia.org/wiki/The_Thinking_Game" },
];
---

<Layout 
  title="Shelf" 
  description="Curated references across books, cinema, and media."
>
  <main class="max-w-2xl mx-auto px-6 pt-8 sm:pt-12 pb-20 sm:pb-24 font-sans">
    
    <!-- Top Minimal Navigation -->
    <header class="mb-10 sm:mb-12">
      <a 
        href="/" 
        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 transition px-3 py-1.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-900/40 hover:border-zinc-400 dark:hover:border-zinc-700"
      >
        ← Home
      </a>
    </header>

    <div class="space-y-10">
      
      <!-- Page Label -->
      <h1 class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
        Shelf
      </h1>

      <!-- Media Sections -->
      <div class="space-y-10">
        
        <!-- Books -->
        <section class="space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-900 dark:text-zinc-100 border-b border-zinc-200 dark:border-zinc-800 pb-2">
            Literature & Biographies
          </h2>
          <ul class="flex flex-col space-y-2 text-xs font-mono">
            {books.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-zinc-300 dark:text-zinc-700 select-none">·</span>
                <a 
                  href={item.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Cinema -->
        <section class="space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-900 dark:text-zinc-100 border-b border-zinc-200 dark:border-zinc-800 pb-2">
            Cinema
          </h2>
          <ul class="flex flex-col space-y-2 text-xs font-mono">
            {cinema.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-zinc-300 dark:text-zinc-700 select-none">·</span>
                <a 
                  href={item.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Television -->
        <section class="space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-900 dark:text-zinc-100 border-b border-zinc-200 dark:border-zinc-800 pb-2">
            Television & Series
          </h2>
          <ul class="flex flex-col space-y-2 text-xs font-mono">
            {television.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-zinc-300 dark:text-zinc-700 select-none">·</span>
                <a 
                  href={item.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition inline-flex items-center gap-1"
                >
                  {item.title}
                  {item.ongoing && (
                    <span class="text-zinc-400 dark:text-zinc-500 font-semibold select-none">*</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Documentaries -->
        <section class="space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-900 dark:text-zinc-100 border-b border-zinc-200 dark:border-zinc-800 pb-2">
            Documentaries
          </h2>
          <ul class="flex flex-col space-y-2 text-xs font-mono">
            {documentaries.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-zinc-300 dark:text-zinc-700 select-none">·</span>
                <a 
                  href={item.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white transition"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>

      </div>

      <!-- Minimal Footer Footnote -->
      <footer class="pt-8 border-t border-zinc-200/60 dark:border-zinc-800/60 text-xs font-mono text-zinc-400 dark:text-zinc-600">
        <span>* Ongoing / in production</span>
      </footer>

    </div>
  </main>
</Layout>